# ═══════════════════════════════════════
#  بُنيان — .gitignore
# ═══════════════════════════════════════

# ── أسرار — لا تُرفع أبداً ──
.env
.env.*
!.env.example

# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
venv/
.venv/
env/

# ── Node ──
node_modules/

# ── قواعد بيانات محلية ──
*.db
*.db.backup_*
*.sqlite
*.sqlite3

# ── سجلات التشغيل ──
*.log
srv_err.txt
srv_out.txt
server_err.log
server_p8*.log
srv.log

# ── المحررات ──
.idea/
.vscode/
*.swp

# ── نظام التشغيل ──
Thumbs.db
desktop.ini
.DS_Store

# ── ملفات مؤقتة ──
test_img.png
*.tmp

# ── نسخ pg_dump الاحتياطية — تحوي بيانات إنتاج حقيقية ──
backups/
*.dump

# ── النسخ اليدوية القديمة ──
# حُفظت في commit المهمة 0.1 ثم حُذفت من القرص في المهمة 0.6.
# لاستعادتها:  git show 9f33e60 -- backups/
backups/
*_backup.*
