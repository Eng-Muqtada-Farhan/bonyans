{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "bunyan-server",
      "runtimeExecutable": ".\\venv\\Scripts\\python.exe",
      "runtimeArgs": ["-m", "uvicorn", "main:app", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000,
      "autoPort": false
    },
    {
      "name": "bunyan-static",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "serve", "-l", "8080", "."],
      "port": 8080
    }
  ]
}
