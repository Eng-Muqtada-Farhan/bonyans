# ═══════════════════════════════════════
#  بُنيان — قالب متغيرات البيئة
#  محلياً: انسخه إلى .env واملأ القيم. cp .env.example .env
#  على Railway: تُضبط من لوحة Settings → Variables مباشرة —
#  هذا الملفّ توثيق للأسماء فقط، لا يُرفع أبداً بقيم حقيقية.
# ═══════════════════════════════════════

# ── حساب الإدارة ──
ADMIN_USERNAME=admin
# لا كلمة مرور صريحة — main.py يتحقّق من التجزئة وحدها.
# ولّدها بـ: python set_admin_password.py
ADMIN_PASSWORD_HASH=

# ── توقيع الرموز ──
# ولّده بـ:  python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=

# ── قاعدة البيانات (Neon) ──
# postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=
# الاتصال المباشر (بدون -pooler) — يستخدمه Alembic وpg_dump/pg_restore
# وحدهما. مجمّع Neon يعمل بوضع المعاملات ولا يناسب DDL/عمليات طويلة.
DATABASE_URL_UNPOOLED=

# ── تخزين الصور — ImageKit ──
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ── الأمان ──
# نطاقات مفصولة بفاصلة. لا تستخدم * أبداً.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# production تُطفئ /docs/redoc/openapi.json وتضيف Secure+HSTS
ENVIRONMENT=development
# https://bonyans.com في الإنتاج — رابط أساس روابط البريد (استعادة
# كلمة المرور، التفعيل). القيمة المحلّية الافتراضية صالحة للتطوير فقط.
PUBLIC_BASE_URL=http://127.0.0.1:8000

# ── البريد (Resend) ──
RESEND_API_KEY=
MAIL_FROM=بُنيان <no-reply@bonyans.com>
SUPPORT_EMAIL=support@bonyans.com

# ── قفل ما قبل الإطلاق ──
# غائب أو أي قيمة غير "1" = لا قفل — الموقع علني كاملاً. هذا هو
# الافتراضي الآمن أثناء التطوير، لكنه يعني أن نسخ هذا الملف كما هو
# إلى Railway قبل الإطلاق العلني الأول ينشر الموقع بلا حماية.
# اضبط PRELAUNCH_LOCK=1 مع PRELAUNCH_USER/PRELAUNCH_PASS *قبل* أول
# نشر علني، واحذف الثلاثة (أو صفّر PRELAUNCH_LOCK) حين تصبح جاهزاً.
PRELAUNCH_LOCK=0
# لازمان فقط إن كان PRELAUNCH_LOCK=1. فشل آمن: لو فُعِّل القفل
# وبقي أحدهما فارغاً، يُمنع كل الوصول بـ503 لا أن يُفتح بصمت.
PRELAUNCH_USER=
PRELAUNCH_PASS=

# ── مُشغِّل التطهير الاحتياطي الخارجي ──
# سرّ يقارَن برأس X-Internal-Token على POST /internal/run-purge-job —
# لمُجدوِل خارجي (Railway Cron Job مثلاً) يستيقظ الخدمة إن نامت.
# فارغ = المسار مرفوض دائماً (404) — آمن بلا ضبط، لا حاجة لتعطيله.
INTERNAL_JOB_TOKEN=

# ── الاختبارات المحلية فقط — لا تضبطه في الإنتاج أبداً ──
# غيابه هنا مقصود: تحدّده مجموعة الاختبارات نفسها (tests/conftest.py)
# لا .env — وجوده في .env الحقيقي يعني تعطيل حلقة التطهير بالخطأ.
# DISABLE_PURGE_LOOP=1
