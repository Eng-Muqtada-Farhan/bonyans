# ═══════════════════════════════════════
#  بُنيان — قالب متغيرات البيئة
#  انسخه إلى .env واملأ القيم الحقيقية
#  cp .env.example .env
# ═══════════════════════════════════════

# ── حساب الإدارة ──
# لا تستخدم كلمة قصيرة. 16 محرفاً على الأقل.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# ولّد التجزئة بـ:
#   python -c "import bcrypt;print(bcrypt.hashpw(b'كلمتك',bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=

# ── توقيع الرموز ──
# ولّده بـ:  python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ── قاعدة البيانات ──
# postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# الاتصال المباشر (بدون -pooler) — يستخدمه Alembic وحده.
# مجمّع Neon يعمل بوضع المعاملات ولا يناسب DDL الطويل.
DATABASE_URL_UNPOOLED=

# ── تخزين الصور — ImageKit ──
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ── الأمان — أضفها عند تنفيذ المرحلة 1 ──
# نطاقات مفصولة بفاصلة. لا تستخدم * أبداً.
CORS_ORIGINS=http://localhost:8000,https://bonyans.com,https://www.bonyans.com,capacitor://localhost
# اجعلها production عند النشر لإطفاء /docs
ENVIRONMENT=development

# ── البريد — المرحلة 2 ──
RESEND_API_KEY=
MAIL_FROM=no-reply@bonyans.com
SUPPORT_EMAIL=support@bonyans.com
